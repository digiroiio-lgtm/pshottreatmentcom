# Analytics (GA4). Without this ID no analytics script or cookie banner is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Assessment form delivery. Configure at least one channel, otherwise the form returns 503 in production
# (it never reports success for a lead that was not delivered).
RESEND_API_KEY=
# Comma-separated recipients (the clinic mailbox is penilerehab@gmail.com)
LEAD_NOTIFY_EMAIL=
# A sender on a domain verified in Resend, for example: UZ Clinic <leads@yourdomain.com>
LEAD_FROM_EMAIL=
# Optional: Zapier / Make / CRM endpoint that receives the lead as JSON (includes score and tier)
LEAD_WEBHOOK_URL=

# Search Console / Bing Webmaster verification (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
