# Analytics (GA4). Without this ID no analytics script or cookie banner is loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Assessment form delivery. The form posts to /api/assessment, which validates, scores the lead and forwards it.
# Channels: Formspree (on by default), Resend email, generic webhook. If every configured channel fails, or none is
# configured, the form returns 503 and shows a WhatsApp fallback (it never reports success for an undelivered lead).
# Formspree endpoint (default https://formspree.io/f/xeaobzzg). Set to "off" to disable.
FORMSPREE_ENDPOINT=
RESEND_API_KEY=
# Comma-separated recipients (the clinic mailbox is penilerehab@gmail.com)
LEAD_NOTIFY_EMAIL=
# A sender on a domain verified in Resend, for example: UZ Clinic <leads@yourdomain.com>
LEAD_FROM_EMAIL=
# Optional: Zapier / Make / CRM endpoint that receives the lead as JSON (includes score and tier)
LEAD_WEBHOOK_URL=

# Search Console / Bing Webmaster verification (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key (letters, digits, dashes; 8-128 chars). Serves /<key>.txt; submit URLs after deploys with `npm run indexnow`.
INDEXNOW_KEY=
